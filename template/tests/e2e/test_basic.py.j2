"""Basic e2e tests shipped by the template.

OBS opens, is drivable, and the plugin is loaded. These are kept
deliberately generic: they hold for every plugin in the fleet. Plugins
extend the suite in this directory with interaction tests for their own
UI surface, marked ``interaction`` — those run only when explicitly
requested (``-m interaction``); the default run deselects them.
"""

from __future__ import annotations

import re
from pathlib import Path

from conftest import WAIT_SECONDS

#: Upstream plugin project name (recorded by the copier template).
PLUGIN_NAME = "{{ plugin_name }}"

#: The OBS version string shown in the About dialog, e.g. "OBS 32.0.3".
OBS_VERSION_RE = r"OBS \d+\."


def test_obs_is_on_the_accessibility_bus(obs, e2e) -> None:
    """The accessibility bus must see OBS for any UI driving to work."""
    apps = e2e("atspi", "apps")
    assert "obs" in apps.stdout.split()


def test_about_dialog_shows_the_obs_version(obs, e2e) -> None:
    """Input (menu click) and dialog rendering both work."""
    e2e("atspi", "click", "menu item", "About", "--wait", WAIT_SECONDS)
    matched = e2e(
        "atspi", "assert", OBS_VERSION_RE, "--wait", WAIT_SECONDS, check=False
    )
    assert matched.returncode == 0, matched.stderr or "OBS version not found"


def test_plugin_module_is_loaded(obs, e2e) -> None:
    """OBS lists the plugin's module among its loaded modules."""
    log = Path(e2e("obslog").stdout.strip())
    content = log.read_text(errors="replace")
    # OBS prints a "Loaded Modules:" section at startup, closed by a
    # dashed separator. Note that "Failed to load 'en-US' text for
    # module: '<name>.so'" lines are normal noise for plugins without
    # locale files — not load failures.
    modules = re.search(r"Loaded Modules:\n(.*?)-{20,}", content, re.S)
    assert modules is not None, "no Loaded Modules section in the OBS log"
    # Module lines carry a timestamp prefix, so anchor on the line end.
    assert re.search(rf"{PLUGIN_NAME}\.so$", modules.group(1), re.M), (
        f"{PLUGIN_NAME}.so not among the loaded modules"
    )
